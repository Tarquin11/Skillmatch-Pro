DATABASE_URL=sqlite:///./skillmatch.db
SECRET_KEY=change-me-in-production-with-a-long-random-string

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

PROJECT_NAME=SkillMatch Pro

# CV parser ops / feature flags
CV_PARSER_MODEL_VERSION=cv_parser_v1
CV_PARSER_MIN_CONFIDENCE=0.6
CV_PARSER_USE_SEMANTIC=false
CV_PARSER_USE_HF_NER=true
CV_PARSER_USE_SEMANTIC_AUGMENT=true
CV_PARSER_SKILL_TIME_BUDGET_SECONDS=0.75
CV_PARSER_SLO_MS=2000
CV_PARSER_SEMANTIC_AUGMENT_MIN_SIMILARITY=0.80
CV_PARSER_SEMANTIC_AUGMENT_TOP_CANDIDATES=5
CV_PARSER_SEMANTIC_AUGMENT_MAX_SPANS=72
CV_PARSER_SEMANTIC_AUGMENT_MIN_LEXICAL_OVERLAP=0.08
CV_PARSER_SEMANTIC_AUGMENT_BASE_THRESHOLD=0.69
CV_PARSER_SEMANTIC_AUGMENT_AMBIGUOUS_BASE_THRESHOLD=0.78
CV_PARSER_SEMANTIC_AUGMENT_AMBIGUOUS_MIN_SIM_BONUS=0.05
CV_PARSER_SEMANTIC_AUGMENT_AMBIGUOUS_MIN_LEXICAL=0.45
CV_PARSER_SEMANTIC_AUGMENT_HARD_AMBIGUITY=go,r,c,ai
CV_PARSER_SEMANTIC_AUGMENT_CALIBRATION_PATH=app/config/semantic_augment_calibration.json

# Fixed validation quality gates
CV_QUALITY_GATE_MIN_PRECISION_AT_1=0.90
CV_QUALITY_GATE_MIN_TECHNICAL_F1=0.84
CV_QUALITY_GATE_MAX_SEMANTIC_AUGMENT_FP_RATE=0.08
CV_QUALITY_GATE_MIN_BOARDS_EXCLUSIVITY_ACCURACY=0.95
CV_QUALITY_GATE_MAX_ECE=0.06
