{
  "metrics": {
    "enabled": true,
    "minimums": {
      "roc_auc": 0.9,
      "f1": 0.85,
      "map_at_k": 0.85
    }
  },
  "drift": {
    "enabled": true,
    "report_path": "artifacts/drift_report.json",
    "max_abs_delta": {
      "pos_ratio_delta": 0.05,
      "missing_employee_skills_delta": 0.05,
      "missing_job_skills_delta": 0.05
    }
  },
  "generalization": {
    "enabled": true,
    "report_path": "artifacts/generalization_report.json",
    "classification_threshold": 0.45,
    "required_scenarios": {
      "iid_val": {
        "roc_auc": 0.9,
        "f1": 0.85,
        "map_at_k": 0.78
      },
      "candidate_disjoint_val": {
        "roc_auc": 0.84,
        "f1": 0.78,
        "map_at_k": 0.78
      },
      "job_disjoint_val": {
        "roc_auc": 0.84,
        "f1": 0.78,
        "map_at_k": 0.78
      }
    }
  },
  "robustness": {
    "enabled": true,
    "report_path": "artifacts/cv_robustness_report.json",
    "minimums": {
      "schema_valid_rate": 1.0
    },
    "maximums": {
      "crash_rate": 0.0
    },
    "advisory_maximums": {
      "degraded_rate": 0.3,
      "empty_text_rate": 0.05
    },
    "tracked": [
      "degraded_rate",
      "empty_text_rate"
    ]
  }
}
